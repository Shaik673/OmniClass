# Internal service authentication. Must match backend FASTAPI_INTERNAL_SECRET.
INTERNAL_AUTH_SECRET=your_internal_auth_secret_here
ENVIRONMENT=development
FASTAPI_PORT=8000
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?appName=Cluster0
REDIS_URL=redis://default:password@redis-host:6379
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_COLLECTION=course_content
VECTOR_DIMENSIONS=384
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PRIMARY_MODEL_URL=http://localhost:11434
PRIMARY_MODEL_NAME=Nexus
PRIMARY_MODEL_TIMEOUT_SECONDS=30
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FALLBACK_ENABLED=false
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_TOKENS=4096
GEMINI_MAX_RETRIES=2
AI_DAILY_TOKEN_QUOTA=50000
LOG_LEVEL=info
